  m_Script: {fileID: 11500000, guid: 007dc1e2feb265b41b2c557933f8198e, type: 3}
  m_Name: Marijuana Interaction
  m_EditorClassIdentifier: Assembly-CSharp::DialogueConstructor
  dialogueScript: "My friend thinks I should try hitting his joint. I'm not sure,
    what do you think?\n\tIt's a party, go for it!\n\t\tWhat if I regret it?\n\t\t\tJust
    do it bro\n\t\t\t\tO-ok\n\t\t\tIt's only one time\n\t\t\t\tYeah, you're right,
    it's only one time\n\t\t\tMaybe you shouldn't do it\n\t\t\t\tYeah, you're right.
    Thanks.\n\tIf you're unsure then there's no harm in saying no.\n\t\tYeah, you're
    right. Thanks."
